{
  "compilerOptions": {
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    "target": "es2022",
    "module": "esnext",

    "allowJs": true,
    "checkJs": false,
    "noEmit": false,
    "noEmitOnError": false,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strict": false
  },
  "include": ["src/**/*", "global.d.ts"]
}
