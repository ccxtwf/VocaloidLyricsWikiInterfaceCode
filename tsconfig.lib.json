{
  "compilerOptions": {
    "target": "es2019",
    "useDefineForClassFields": false,
    "lib": ["ES2019", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    "module": "esnext",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,

    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "noEmitOnError": false,

    "rootDir": "./src",
    "outDir": "./dist",

    "typeRoots": ["./node_modules/@types"],
    "types": ["node", "jquery", "oojs", "oojs-ui"],

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strict": false
  },
  "include": [
    "src/**/*",
    "./node_modules/types-mediawiki/**/*.d.ts",
    "./node_modules/types-mediawiki-api/**/*.d.ts",
    "./node_modules/@vue/**/*.d.ts"
  ]
}
